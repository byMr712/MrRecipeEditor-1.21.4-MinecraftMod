{
  "schemaVersion": 1,
  "id": "recipeeditor",
  "version": "${version}",
  "name": "[MR] Recipe Editor",
  "description": "Universal In-Game Recipe Editor and Creator for Minecraft 1.21.4. Create, modify, and auto-detect recipes for any vanilla or modded items directly in-game with drag & drop support.",
  "authors": [
    "Mr712"
  ],
  "contact": {
    "sources": "https://github.com/byMr712/MrRecipeEditor-MinecraftMod"
  },
  "license": "Apache-2.0",
  "icon": "assets/recipeeditor/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.recipeeditor.RecipeEditorMod"
    ],
    "client": [
      "com.recipeeditor.client.RecipeEditorClient"
    ],
    "modmenu": [
      "com.recipeeditor.integration.ModMenuIntegration"
    ],
    "rei_client": [
      "com.recipeeditor.integration.rei.RecipeEditorReiClientPlugin"
    ]
  },
  "mixins": [
    "recipeeditor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.4",
    "java": ">=21",
    "modmenu": "*",
	"fabric-api": "*"
  },
  "suggests": {
    "roughlyenoughitems": "*"
  }
}
